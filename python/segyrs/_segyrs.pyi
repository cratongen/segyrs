"""Type stub for the native extension ``segyrs._segyrs``. The public API is in ``segyrs``."""

import os
from collections.abc import Mapping, Sequence
from typing import Any, final

import numpy as np
from numpy.typing import NDArray

_Budget = int | float | None
_Capsule = Any  # a PyCapsule named "segyrs.reader.v1" (segyrs::bridge)
_Overlay = tuple[int, str, str, NDArray[Any], NDArray[np.int16] | None]
_Predicate = tuple[str, float | None, float | None, list[float] | None]
_Fixed = Sequence[tuple[str, int]]
_Ranges = Sequence[tuple[str, int, int, int]]

class SegyrsError(Exception): ...
class GeometryError(SegyrsError): ...
class GeometryAssumptionError(GeometryError): ...
class DuplicateKey(SegyrsError): ...
class EndianMismatch(SegyrsError): ...
class SampleCountMismatch(SegyrsError): ...
class NonUniformTraceLength(SegyrsError): ...
class TraceLengthError(SegyrsError): ...
class FormatChangeError(SegyrsError): ...
class Format4NeedsGain(SegyrsError): ...
class UnknownFormat(SegyrsError): ...
class TruncatedError(SegyrsError): ...
class UnsortedCoordinate(SegyrsError): ...
class HeaderValueError(SegyrsError): ...
class SampleValueError(SegyrsError): ...
class SpecError(SegyrsError): ...
class NotSegyError(SegyrsError): ...

class ValidationError(SegyrsError):
    problems: list[str]

class SegyrsIOError(SegyrsError, OSError): ...
class PathNotFoundError(SegyrsIOError, FileNotFoundError): ...
class PathPermissionError(SegyrsIOError, PermissionError): ...
class PathIsDirectoryError(SegyrsIOError, IsADirectoryError): ...
class SegyrsValueError(SegyrsError, ValueError): ...
class BudgetError(SegyrsError, MemoryError): ...

@final
class File:
    def __new__(
        cls,
        path: str,
        *,
        storage_options: Mapping[str, str] | None = None,
        sample_format: str | None = None,
        endian: str | None = None,
        gain: str | None = None,
        inline_byte: int = 189,
        crossline_byte: int = 193,
        offset_byte: int = 37,
        scan: str = "auto",
        index_cache: str | None = None,
    ) -> File: ...
    def reader(self) -> _Capsule: ...
    @property
    def binary_format_code(self) -> int: ...
    @property
    def data_start(self) -> int: ...
    @property
    def dtype(self) -> str: ...
    @property
    def extra_trace_header_blocks(self) -> int: ...
    @property
    def gain(self) -> str | None: ...
    @property
    def measurement_system(self) -> int | None: ...
    @property
    def n_samples(self) -> int: ...
    @property
    def n_traces(self) -> int: ...
    @property
    def path(self) -> str | os.PathLike[str]: ...
    @property
    def revision(self) -> str: ...
    @property
    def sample_format(self) -> str: ...
    @property
    def sample_interval_us(self) -> int: ...
    @property
    def samples_read(self) -> int: ...
    @property
    def source_endian(self) -> str: ...
    @staticmethod
    def standard_fields() -> list[tuple[str, int, str]]: ...
    def binary_header_bytes(self) -> bytes: ...
    def geometry(self) -> dict[str, Any]: ...
    def header_bytes(self, trace: int) -> bytes: ...
    def header_columns(self, fields: Sequence[tuple[str, int, str]]) -> dict[str, NDArray[Any]]: ...
    def lookup(self, inline: int, crossline: int) -> NDArray[np.int64]: ...
    def read(self, traces: NDArray[np.int64], start: int, stop: int) -> NDArray[Any]: ...
    def scanned_columns(self) -> dict[str, NDArray[Any]]: ...
    def textual_header(self) -> list[tuple[str, list[str]]]: ...

@final
class Drawer:
    def __new__(cls, file: File, *, depth: bool = False) -> Drawer: ...
    @property
    def dims(self) -> list[str]: ...
    def picture(
        self,
        fixed: _Fixed,
        ranges: _Ranges,
        *,
        clip: float | None = None,
        live: NDArray[np.bool_] | None = None,
        width: int = 800,
        height: int = 480,
        colormap: str = "grey",
        polarity: str = "normal",
        gain: float = 1.0,
        wiggle: str = "off",
        wiggle_every: int = 1,
        density: bool = True,
    ) -> tuple[bytes, str, str | None, int]: ...

@final
class Editor:
    def __new__(cls, path: str) -> Editor: ...
    @property
    def closed(self) -> bool: ...
    @property
    def n_samples(self) -> int: ...
    @property
    def n_traces(self) -> int: ...
    @property
    def sample_format(self) -> str: ...
    def close(self) -> None: ...
    def sync(self) -> None: ...
    def write_binary_header(self, data: bytes) -> None: ...
    def write_header_columns(
        self, overlays: Sequence[_Overlay], traces: NDArray[np.int64] | None = None
    ) -> None: ...
    def write_textual_block(self, index: int, data: bytes) -> None: ...
    def write_traces(self, first: int, samples: NDArray[Any]) -> None: ...

